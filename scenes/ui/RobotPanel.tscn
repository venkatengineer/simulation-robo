[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/RobotPanelController.gd" id="1_robot_panel"]

[node name="RobotPanel" type="PanelContainer"]
custom_minimum_size = Vector2(260, 360)
offset_right = 260.0
offset_bottom = 360.0
script = ExtResource("1_robot_panel")

[node name="VBoxContainer" type="VBoxContainer" parent="."]
layout_mode = 2

[node name="Header" type="HBoxContainer" parent="VBoxContainer"]
layout_mode = 2

[node name="LabelID" type="Label" parent="VBoxContainer/Header"]
layout_mode = 2
text = "ROBOT R01"
horizontal_alignment = 1

[node name="Grid" type="GridContainer" parent="VBoxContainer"]
layout_mode = 2
columns = 2

[node name="LabelStatus" type="Label" parent="VBoxContainer/Grid"]
layout_mode = 2
text = "Status:"

[node name="LabelStatusValue" type="Label" parent="VBoxContainer/Grid"]
layout_mode = 2
text = "READY"

[node name="LabelPriority" type="Label" parent="VBoxContainer/Grid"]
layout_mode = 2
text = "Priority:"

[node name="SpinPriority" type="SpinBox" parent="VBoxContainer/Grid"]
layout_mode = 2
min_value = 1.0
max_value = 20.0
value = 5.0

[node name="LabelStart" type="Label" parent="VBoxContainer/Grid"]
layout_mode = 2
text = "Start:"

[node name="LabelStartValue" type="Label" parent="VBoxContainer/Grid"]
layout_mode = 2
text = "N01"

[node name="LabelGoal" type="Label" parent="VBoxContainer/Grid"]
layout_mode = 2
text = "Goal:"

[node name="LabelGoalValue" type="Label" parent="VBoxContainer/Grid"]
layout_mode = 2
text = "N09"

[node name="LabelSpeed" type="Label" parent="VBoxContainer/Grid"]
layout_mode = 2
text = "Speed:"

[node name="SpinSpeed" type="SpinBox" parent="VBoxContainer/Grid"]
layout_mode = 2
min_value = 20.0
max_value = 300.0
value = 100.0

[node name="LabelPath" type="Label" parent="VBoxContainer/Grid"]
layout_mode = 2
text = "Path:"

[node name="LabelPathValue" type="Label" parent="VBoxContainer/Grid"]
layout_mode = 2
text = "None"

[node name="BtnSetStart" type="Button" parent="VBoxContainer"]
layout_mode = 2
text = "SET START"

[node name="BtnSetGoal" type="Button" parent="VBoxContainer"]
layout_mode = 2
text = "SET GOAL"

[node name="BtnPlan" type="Button" parent="VBoxContainer"]
layout_mode = 2
text = "PLAN PATH"

[node name="BtnStart" type="Button" parent="VBoxContainer"]
layout_mode = 2
text = "START ROBOT"

[node name="BtnManual" type="Button" parent="VBoxContainer"]
layout_mode = 2
toggle_mode = true
text = "MANUAL CONTROL"

[node name="BtnFail" type="Button" parent="VBoxContainer"]
layout_mode = 2
text = "FAIL ROBOT"

[node name="BtnDelete" type="Button" parent="VBoxContainer"]
layout_mode = 2
text = "DELETE ROBOT"

[connection signal="value_changed" from="VBoxContainer/Grid/SpinPriority" to="." method="_on_spin_priority_value_changed"]
[connection signal="pressed" from="VBoxContainer/BtnSetStart" to="." method="_on_btn_set_start_pressed"]
[connection signal="pressed" from="VBoxContainer/BtnSetGoal" to="." method="_on_btn_set_goal_pressed"]
[connection signal="pressed" from="VBoxContainer/BtnPlan" to="." method="_on_btn_plan_pressed"]
[connection signal="pressed" from="VBoxContainer/BtnStart" to="." method="_on_btn_start_pressed"]
[connection signal="toggled" from="VBoxContainer/BtnManual" to="." method="_on_btn_manual_toggled"]
[connection signal="pressed" from="VBoxContainer/BtnFail" to="." method="_on_btn_fail_pressed"]
[connection signal="pressed" from="VBoxContainer/BtnDelete" to="." method="_on_btn_delete_pressed"]
